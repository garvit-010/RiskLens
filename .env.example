# RiskLens – environment variable template
# The system runs fully offline by default; no keys are required.
# Fill in only if you want to enable live news ingestion (optional stretch feature).

# NewsAPI key – placeholder only; live ingestion is disabled by default
NEWSAPI_KEY=your_newsapi_key_here

# Set to "true" to run engine in live mode instead of cached replay
RISKLENS_LIVE_MODE=false

# Streamlit dashboard port (default 8501)
STREAMLIT_PORT=8501

# FastAPI server port (default 8000)
API_PORT=8000

# Impact threshold above which Module B stress test triggers (default 7.0)
IMPACT_THRESHOLD=7.0
